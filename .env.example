# Copy this file to .env and fill in a real key.
# .env is gitignored; this file is the committed template.
#
# IMPORTANT: exactly ONE block below may be uncommented. python-dotenv is
# last-wins, so leaving several active silently uses the bottom-most one.
#
# Model names go stale as providers retire them. If you get a 404
# "model does not exist", list what your key can actually reach:
#   uv run python -c "import os,asyncio;from dotenv import load_dotenv;from openai import AsyncOpenAI;load_dotenv();\
#   asyncio.run((lambda c: c.models.list())(AsyncOpenAI(api_key=os.environ['STUDY_HELPER_API_KEY'],\
#   base_url=os.environ['STUDY_HELPER_BASE_URL'])))"

# --- active: Google Gemini (OpenAI-compatible endpoint) ---
STUDY_HELPER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
STUDY_HELPER_API_KEY=your-key-here
STUDY_HELPER_MODEL=gemini-2.5-flash

# --- alternatives: comment out the block above, uncomment one below ---

# OmniRoute (self-hosted gateway, https://github.com/diegosouzapw/OmniRoute)
# STUDY_HELPER_BASE_URL=http://localhost:20128/v1
# STUDY_HELPER_API_KEY=<key from the OmniRoute dashboard>
# STUDY_HELPER_MODEL=auto/best-free

# OpenRouter
# STUDY_HELPER_BASE_URL=https://openrouter.ai/api/v1
# STUDY_HELPER_API_KEY=sk-or-v1-...
# STUDY_HELPER_MODEL=deepseek/deepseek-chat-v3.1:free

# Groq  (verified working 2026-09-14)
# STUDY_HELPER_BASE_URL=https://api.groq.com/openai/v1
# STUDY_HELPER_API_KEY=gsk_...
# STUDY_HELPER_MODEL=openai/gpt-oss-120b

# Ollama (local, no key needed)
# STUDY_HELPER_BASE_URL=http://localhost:11434/v1
# STUDY_HELPER_API_KEY=ollama
# STUDY_HELPER_MODEL=llama3.1


# --- optional: a second model just for structured output (quiz agents) ---
#
# Only needed when your main model cannot do both jobs. Measured on free tiers:
#
#   Groq gpt-oss-120b     tools yes, handoffs yes, multi-field JSON NO
#   OpenRouter Nemotron   JSON yes, tools NO
#   Gemini 3 Flash        both yes, but 20 requests per DAY
#
# Leave these unset and quiz agents use the main model. Set only
# STUDY_HELPER_STRUCTURED_MODEL to switch model on the same provider; set all
# three to use a different provider entirely.
#
# STUDY_HELPER_STRUCTURED_BASE_URL=https://openrouter.ai/api/v1
# STUDY_HELPER_STRUCTURED_API_KEY=sk-or-v1-...
# STUDY_HELPER_STRUCTURED_MODEL=nvidia/nemotron-3-super-120b-a12b:free
